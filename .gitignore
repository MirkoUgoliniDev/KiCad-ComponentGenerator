# Python caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-build/
venv/
env/

# Local configuration and secrets
.env
.env.*
# The template holds only a placeholder key and is shipped by the build
# (packaging/KiCadGen.spec) and required by tests/test_packaging.py.
!.env.example
config.json
data/*.sqlite3*
!data/analysis_profiles.sqlite3
data/config-before-sqlite-*.json

# Cache locale dell'elenco modelli OpenRouter
.openrouter_models.json

# Generated component output and local exports
generated/
examples/output/
dist/
build/
*.tmp
*.log
# Log del programma avviato da sorgente (rapporti di crash compresi).
logs/

# FreeCAD temporary files
*.FCStd1
*.FCStd~

# KiCad local state
*.kicad_prl
*.lck
*.bak
*-bak
~*

# OS/editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Local detector weights (large binaries; review upstream licences before redistribution).
models/*.onnx
models/**/*.onnx
# Pesi PyTorch dei modelli addestrati (Colab, Roboflow): licenza da decidere.
# Dal 2026-10-02 in due cartelle: models/yolo/ (rilevatori) e models/smd/
# (rete che classifica i corpi).
models/*.pt
models/**/*.pt
# Altri formati di pesi (verifica C-L4, 2026-10-02): nessun checkpoint nel repository.
models/**/*.pth
models/**/*.ckpt
models/**/*.safetensors
models/**/*.bin
models/**/*.engine
models/**/*.tflite

# .claude/ va su GitHub (istruzioni, agenti, skill: utente, 2026-09-24);
# restano fuori solo gli alberi di lavoro temporanei dei sottoagenti, che sono
# copie complete del repository.
.claude/worktrees/
.claude/settings.local.json

# Materiale privato dell'utente: mai su GitHub (utente, 2026-09-24).
Private/
# Stessa cartella scritta in minuscolo (dataset, annotazioni private): mai su GitHub.
private/

# Output di lavoro degli agenti Claude: mai su GitHub.
Claude outputs/

# Local scratch areas and pickled dumps of debugging sessions (never sources)
/tmp/
/work/
*.pkl

# Component documents placed by the user in docs/<component>/ (datasheets,
# drawings, photos) are private material: never on GitHub unless added on
# purpose. The rule targets the document and image formats, not a part name,
# so every new component folder is covered; Markdown notes under docs/ stay
# visible. Ignore rules never untrack a file: the sample folders already
# tracked (docs/ESP32, docs/RS485, docs/VE12H-K, docs/MFG_TEL-8-2411WI) keep
# their files, and a new sample is added deliberately with `git add -f`.
docs/*/**/*.pdf
docs/*/**/*.png
docs/*/**/*.jpg
docs/*/**/*.jpeg
docs/*/**/*.webp
docs/*/**/*.bmp
docs/*/**/*.gif
docs/*/**/*.tif
docs/*/**/*.tiff
docs/*/**/*.heic
# The README screenshots (tools/make_readme_screenshots.py) are sources.
!docs/images/*.png
